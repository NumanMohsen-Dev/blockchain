# ==============================================================================
# Environment Configuration Template
# Digital Evidence Chain of Custody System
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration (PostgreSQL)
POSTGRES_DB=evidence_custody
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@postgres:5432/evidence_custody

# Backend Server Configuration
BACKEND_PORT=8000
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Security (JWT)
# IMPORTANT: Generate a secure 32+ character random secret for production!
JWT_SECRET_KEY=development_jwt_secret_key_change_in_production_min_32_chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence Storage Parameters
EVIDENCE_STORAGE_PATH=/app/storage/evidence
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB

# Blockchain Parameters (Ethereum / Hardhat)
HARDHAT_RPC_URL=http://blockchain:8545
BLOCKCHAIN_CHAIN_ID=31337
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=/app/deployments/contract_info.json

# Development Signer (Hardhat Account #0 default - DO NOT USE IN PRODUCTION)
DEVELOPMENT_SIGNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEVELOPMENT_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Automatic Seeding of Forensic Role Accounts
SEED_DEMO_USERS=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
