# ==============================================================================
# Blockchain Evidence Chain-of-Custody - Backend Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="Blockchain-Based Digital Evidence Chain-of-Custody System"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=evidence_custody
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_custody

# Authentication & Security
JWT_SECRET_KEY=development_jwt_secret_key_change_in_production_min_32_chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence Storage
EVIDENCE_STORAGE_PATH=/app/storage/evidence
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB

# Blockchain & Smart Contract
# When running locally on host: http://127.0.0.1:8545
# When running inside Docker container: http://blockchain:8545
HARDHAT_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=app/blockchain/contract_info.json

# Development Relayer / Signer Account (Account #0 in Hardhat default test node)
# WARNING: NEVER USE REAL FUNDS OR PRODUCTION KEYS WITH THIS DEVELOPMENT KEY
DEVELOPMENT_SIGNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEVELOPMENT_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Seed Demo Users on Startup
SEED_DEMO_USERS=True

